{
  "name": "sejong-campus-guide",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --ip 127.0.0.1",
    "dev:site": "astro dev --root site",
    "build": "astro build --root site",
    "check": "wrangler types --include-runtime=true && tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
    "test": "vitest run tests/unit",
    "test:e2e": "npm run build && playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.76.0"
  }
}
