---
import '../styles/site.css';
const { title, description, home = false } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101b2e" />
    <meta name="description" content={description} />
    <title>{title} · 세종 캠퍼스 가이드</title>
    <script is:inline src="/analytics.js" defer></script>
  </head>
  <body data-home={home ? 'true' : undefined}>
    <a class="skip" href="#main">본문으로 이동</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          <span class="brand-icon" aria-hidden="true"><i></i></span>
          <span>세종 캠퍼스 가이드</span>
        </a>
        <a class="header-link" href={home ? '#restaurants' : '/'}>{home ? '식당 바로가기' : '오늘 메뉴'}</a>
      </div>
    </header>
    <main class="shell" id="main">
      <slot />
    </main>
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
